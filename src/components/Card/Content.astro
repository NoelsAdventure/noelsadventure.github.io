---
interface Props {
  title?: string;
  body?: string;
  colorText?: string;
}

const { title, body, colorText } = Astro.props;
---

<>
  {title && <h2 class={`text-xl font-bold m-0 z-20 relative ${colorText || ""}`}>{title}</h2>}
  {body && <p class="m-0 font-light text-base flex flex-col relative z-20">{body}</p>}
  <slot />
</>
